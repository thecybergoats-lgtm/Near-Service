# .dockerignore for the BACKEND image (build context = repo root).
# Anything matching here is never sent to the Docker daemon, so it can
# never end up in the image — in particular no .env / secret file.
.git
**/node_modules
**/dist
**/.next
**/coverage
**/*.test.ts
**/test
backend/test
backend/uploads
mobile
infra
docs
*.md
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
id_rsa*
terraform.tfvars
.env.prod
