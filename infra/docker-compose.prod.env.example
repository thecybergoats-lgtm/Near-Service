# Near Service — production compose environment (example).
#
#   cp infra/docker-compose.prod.env.example .env.prod
#   # fill in every value, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# NEVER commit the filled .env.prod. No real secret is in this file — every
# secret line is a REPLACE_ME placeholder. Generate fresh values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#     (base64 form is for FIELD_ENCRYPTION_KEY only — exactly 32 bytes)

# --- Images (built by CI and pushed to the ECR repos Terraform creates) ---
BACKEND_IMAGE=REPLACE_ME_ECR_URL/near-service/backend:latest
ADMIN_IMAGE=REPLACE_ME_ECR_URL/near-service/admin:latest

# --- Postgres ---
POSTGRES_DB=nearservice
POSTGRES_USER=nearservice
POSTGRES_PASSWORD=REPLACE_ME_GENERATE_A_STRONG_PASSWORD

# --- Backend ---
# Full connection strings. Self-hosted compose path: postgres/redis are the
# service names below. Managed path (RDS/ElastiCache): replace the hosts
# with the Terraform outputs (rds_endpoint / redis_endpoint).
DATABASE_URL=postgres://nearservice:REPLACE_ME_DB_PASSWORD@postgres:5432/nearservice
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=REPLACE_ME_GENERATE_32_PLUS_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_GENERATE_32_PLUS_CHARS_DIFFERENT_FROM_ACCESS
CNIC_PEPPER=REPLACE_ME_GENERATE_32_PLUS_CHARS
OTP_HASH_SECRET=REPLACE_ME_GENERATE_32_PLUS_CHARS
FIELD_ENCRYPTION_KEY=REPLACE_ME_BASE64_OF_32_BYTES

# sandbox until live merchant onboarding is complete.
PAYMENT_GATEWAY_MODE=sandbox
# S3 bucket URL from Terraform output uploads_base_url; empty = local dev
# receiver (not suitable for production).
STORAGE_UPLOAD_BASE_URL=
# Admin origin only. Empty = no browser origin allowed.
CORS_ORIGINS=https://admin.nearservice.pk

# --- Admin ---
NEXT_PUBLIC_API_URL=https://api.nearservice.pk/api/v1
