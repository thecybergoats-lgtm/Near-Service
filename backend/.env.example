# Near Service backend — copy to .env (never commit .env)
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://nearservice:nearservice@localhost:5432/nearservice
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# DEV ONLY: when true, OTP codes are printed to the server console/log and
# no real SMS is sent. MUST be false in production (real Firebase/SMS gateway).
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS_PER_PHONE_PER_HOUR=5
COMMISSION_RATE_DEFAULT=0.10
# PAYMENT_GATEWAY_MODE: sandbox (default) or live. Live mode REFUSES to boot
# unless the live merchant credentials below are set — it never silently
# falls back to sandbox. See docs/phase2-payments-guide.md for onboarding.
PAYMENT_GATEWAY_MODE=sandbox
# JazzCash sandbox credentials (obtain from the JazzCash sandbox portal;
# these are test values only — never put live keys here).
JAZZCASH_SANDBOX_MERCHANT_ID=
JAZZCASH_SANDBOX_PASSWORD=
JAZZCASH_SANDBOX_RETURN_URL=http://localhost:3000/api/v1/wallet/topup/callback
# Easypaisa sandbox credentials (obtain from the Easypaisa sandbox portal).
EASYPAISA_SANDBOX_STORE_ID=
EASYPAISA_SANDBOX_HASH_KEY=
# LIVE credentials — leave EMPTY until merchant onboarding is complete and
# the live provider integration is implemented. The app will not boot in
# live mode while any of these are missing.
JAZZCASH_LIVE_MERCHANT_ID=
JAZZCASH_LIVE_PASSWORD=
JAZZCASH_LIVE_RETURN_URL=
EASYPAISA_LIVE_STORE_ID=
EASYPAISA_LIVE_HASH_KEY=
FCM_MODE=stub
# CNIC_PEPPER: HMAC key for cnic_hmac. Loaded from the secrets manager in
# production — never hardcode a real value, never log it, never store it in
# the DB. REQUIRED in production (>= 32 chars, must not contain "change-me").
# Dev only: any value works; the app refuses to boot in production without it.
CNIC_PEPPER=change-me-cnic-pepper-min-32-chars
# OTP_HASH_SECRET: keyed-hash (HMAC-SHA256) secret for stored OTP codes.
# REQUIRED in production (>= 32 chars, must not contain "change-me").
OTP_HASH_SECRET=change-me-otp-hash-secret-min-32-chars
# FIELD_ENCRYPTION_KEY: AES-256-GCM key for cnic_encrypted /
# payout_account_encrypted (src/common/crypto/field-encryption.ts).
# REQUIRED in production: base64 of exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate with FIELD_ENCRYPTION_KEY_V2 (same format); old rows stay readable
# because the ciphertext carries a v1:/v2: version prefix.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_V2=
# STORAGE_UPLOAD_BASE_URL: object-storage base for provider document uploads.
# Unset = local dev receiver (PUT /api/v1/uploads/:key, dev only).
# CORS_ORIGINS: browser origins allowed to call the API (comma-separated).
# Empty in production = NO browser origin allowed (FIX 12, Stage 3).
# CORS_ORIGINS=http://localhost:3001
# Phase 4 search scale-out (defaults in src/config/env.ts — these lines
# are documentation; uncomment to override):
# SEARCH_PROVIDER: trigram (Phase 1 SQL, default) or scaled (pg full-text
#   + trigram + Redis cache). A remote service is selected by
#   SEARCH_SERVICE_URL, not by this key.
# SEARCH_PROVIDER=trigram
# SEARCH_SERVICE_URL: set to forward search to an extracted search service
#   (RemoteSearchProvider). Unset = in-process provider.
# SEARCH_SERVICE_URL=
# SEARCH_CACHE_TTL_SECONDS: Redis cache TTL for scaled-provider results.
# SEARCH_CACHE_TTL_SECONDS=120
# SEARCH_CACHE_ENABLED: only the literal string 'false' disables the cache.
# SEARCH_CACHE_ENABLED=true
